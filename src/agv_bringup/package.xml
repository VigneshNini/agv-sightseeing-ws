<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agv_bringup</name>
  <version>1.0.0</version>
  <description>Bringup launch files for AGV Sightseeing Vehicle</description>
  <maintainer email="agv@example.com">AGV Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>agv_localization</exec_depend>
  <exec_depend>agv_perception</exec_depend>
  <exec_depend>agv_mapping</exec_depend>
  <exec_depend>agv_planning</exec_depend>
  <exec_depend>agv_control</exec_depend>
  <exec_depend>agv_safety</exec_depend>
  <exec_depend>agv_tour_manager</exec_depend>
  <exec_depend>agv_teleop</exec_depend>
  <exec_depend>agv_dashboard</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
